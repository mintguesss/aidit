# Aidit 環境變數
#
# 全部留空也能完整執行：Demo、評測、注入測試、CI 都在離線模式下跑得完。
# 填入後才會切換到真實服務 —— 沒有「填了一半」的中間狀態，各項獨立生效。
#
# ┌─────────────────────────────────────────────────────────────────────┐
# │ 三種部署，各自要填的不一樣。照著自己那一欄填，不要整份抄。          │
# ├──────────────────────┬──────────────┬──────────────┬────────────────┤
# │ 變數                 │ Vercel       │ 家用主機     │ 本機開發       │
# │                      │ 公開 demo    │ 真模型       │                │
# ├──────────────────────┼──────────────┼──────────────┼────────────────┤
# │ AIDIT_DATA_DIR       │ /tmp/aidit   │ 留空         │ 留空           │
# │ AIDIT_TRACE_SECRET   │ 必填         │ 必填（同組） │ 同組           │
# │ AIDIT_REVIEW_PASSWORD│ 選填         │ 選填         │ 選填           │
# │ ANTHROPIC_API_KEY    │ 不填         │ 不填         │ 選填           │
# │ AIDIT_LLM_PROVIDER   │ 不填         │ openai-…     │ 不填           │
# │ AIDIT_LLM_BASE_URL   │ 不填         │ 必填         │ 不填           │
# │ AIDIT_LLM_MODEL      │ 不填         │ 必填         │ 選填           │
# │ AIDIT_LLM_TIMEOUT_MS │ 不填         │ 選填         │ 不填           │
# │ AIDIT_LLM_REASONING… │ 不填         │ 思考型填 none│ 不填           │
# │ SUPABASE_*           │ 選填         │ 選填         │ 選填           │
# └──────────────────────┴──────────────┴──────────────┴────────────────┘
#
# Vercel 公開 demo 刻意不接任何模型：離線替身是確定性的，展示時每次結果一樣，
# 也不會因為額度或速率限制在評審面前掛掉。


# ══════════════════════════════════════════════════ 共用（三種部署都要）

# ------------------------------------------------------------------ 去識別
# trace 的 student_hash 使用 HMAC-SHA256(學號, 此密鑰)，不可逆推。
# 正式部署務必改掉：用開發預設值等於全世界都能重算你的雜湊。
# 各部署要用「同一組」，否則同一個學生在不同環境會算出不同 hash，對不起來。
AIDIT_TRACE_SECRET=

# ------------------------------------------------------------------ 校對密碼
# 校對登入（/review/login）的密碼。通常不必設：改用 `npx tsx scripts/set-review-password.ts`
# 存進資料庫的非公開儲存區（加鹽雜湊）。兩者都沒有時，正式部署不開放校對。
# 給校對的人口頭或私訊告知，不要寫進文件或 repo。
AIDIT_REVIEW_PASSWORD=

# ------------------------------------------------------------- 檔案替身位置
# 未設定時：使用 <專案>/.data，那是本機與家用主機該用的值。
# 只有 Vercel 要改：serverless 的專案目錄唯讀，必須設為 /tmp/aidit，
# 否則 trace、偏好、校對紀錄的寫入都會失敗。
AIDIT_DATA_DIR=

# --------------------------------------------------------------- Supabase
# 未設定時：trace 存到 .data/traces/*.json，介面與 Supabase 版完全相同。
# 兩者都設定才會啟用 Supabase。資料表見 supabase/migrations/。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ═══════════════════════════════════════ 只有要用 Anthropic 官方 API 才填

# 未設定時：rule.reconcile、情境試算意圖解析、選課建議微調一律使用
#           確定性替身，trace 會標示 mode=offline，評測報告不把替身當成模型表現。
# 規則抽取（scripts/extract-rulepack.ts）不提供替身，必須有金鑰才能執行。
ANTHROPIC_API_KEY=


# ══════════════════════════════════════════ 模型（家用主機主要改這一段）

# 供應商。未設定＝anthropic。
#   anthropic          官方 API，需要 ANTHROPIC_API_KEY
#   openai-compatible  任何 OpenAI 相容端點：vLLM、Groq、OpenRouter
AIDIT_LLM_PROVIDER=

# provider=anthropic 時，可選（未設定＝claude-haiku-5-5）：
#   claude-haiku-5-5            （預設）
#   claude-sonnet-5-5
#   claude-opus-5-5
#   claude-haiku-4-5-20251001   （不支援 effort，程式會自動不送該欄位）
# 價格見 src/lib/llm/client.ts，實測前到 Anthropic Console 確認
# provider=openai-compatible 時，必填，填端點上的模型名稱
AIDIT_LLM_MODEL=

# 只有 provider=openai-compatible 要填。要帶到 /v1，程式會自己接 /chat/completions。
#   跑在同一台　http://127.0.0.1:<port>/v1
AIDIT_LLM_BASE_URL=

# 只有 provider=openai-compatible 且該端點需要驗證時要填。
# 本機端點不檢查，留空即可；Groq／OpenRouter 要填。
AIDIT_LLM_API_KEY=

# 單次呼叫逾時（毫秒）。未設定時：anthropic 8000、openai-compatible 30000。
# 8 秒是照對話 P95 目標訂的，對本機模型通常不夠。
AIDIT_LLM_TIMEOUT_MS=

# 只有 provider=openai-compatible 可填：送出 reasoning_effort。未設定＝不送這個欄位。
# 思考型模型預設會先想一大段再輸出：實測自架小模型一次意圖解析 14 秒、
# 常常逾時；填 none 後同一題 1.2 秒，輸出相同。意圖解析用不到長鏈推理。
# 可選 none、low、medium、high。部分端點認 none；別的端點不一定認，不確定就留空。
AIDIT_LLM_REASONING_EFFORT=

# 換模型就要重跑整份評測：不同模型的數字不能放在同一張比較表上。
# 評測報告會把實際使用的模型印在標頭（MODEL_LABEL），照著看就不會混。
